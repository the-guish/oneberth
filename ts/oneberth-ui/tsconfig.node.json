{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "node_modules/.tmp/node.tsbuildinfo",
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vite.page.config.ts",
    "dev/vitePlugin.ts",
    "dev/fakeAuth.ts"
  ]
}
